{
  "manifest_version": 3,
  "name": "Seat Assist (persoonlijk)",
  "version": "1.2.10",
  "description": "Monitort voorkeursvakken in Tymes4- en TIXX-ticketshops en zet zodra mogelijk een stoel in je winkelwagen. Draait binnen je ingelogde shop-sessie.",
  "permissions": ["storage"],
  "host_permissions": [
    "__API_ORIGIN__/*",
    "__SHOP_ORIGIN__/*",
    "__TIXX_SCHEDULE_PERMS__",
    "__TIXX_API_ORIGIN__/*",
    "__TIXX_SHOP_ORIGIN__/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["__SHOP_ORIGIN__/*"],
      "js": ["tymes4-content.js"],
      "css": ["tymes4.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["__TIXX_SHOP_ORIGIN____TIXX_SHOP_PATHS__/*"],
      "js": ["tixx-core.js", "tixx-content.js"],
      "css": ["tixx.css"],
      "run_at": "document_idle"
    }
  ]
}
