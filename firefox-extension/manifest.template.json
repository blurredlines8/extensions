{
  "manifest_version": 2,
  "name": "Seat Assist",
  "version": "1.2.5",
  "description": "Monitort voorkeursvakken in Tymes4- en TIXX-ticketshops en zet zodra mogelijk een stoel in je winkelwagen. Draait binnen je ingelogde shop-sessie.",
  "permissions": [
    "__API_ORIGIN__/*",
    "__SHOP_ORIGIN__/*",
    "__TIXX_SCHEDULE_PERMS__",
    "__TIXX_API_ORIGIN__/*",
    "__TIXX_SHOP_ORIGIN__/*"
  ],
  "background": {
    "scripts": ["tixx-core.js", "tixx-background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "__SHOP_ORIGIN__/*"
      ],
      "js": [
        "tymes4-content.js"
      ],
      "css": [
        "tymes4.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "__TIXX_SHOP_ORIGIN____TIXX_SHOP_PATHS__/*"
      ],
      "js": [
        "tixx-core.js",
        "tixx-content.js"
      ],
      "css": [
        "tixx.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "seat-assist@local",
      "update_url": "https://raw.githubusercontent.com/blurredlines8/extensions/main/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
