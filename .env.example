# Kopieer dit bestand naar .env en vul je eigen AMO-credentials in:
#   cp .env.example .env
#
# Ophalen op: https://addons.mozilla.org/developers/addon/api/key/
# .env staat in .gitignore en wordt niet gedeeld/gecommit.
#
# Simpele KEY=value regels, geen spaties rond de =, geen quotes nodig.

WEB_EXT_API_KEY=user:0000000:000
WEB_EXT_API_SECRET=vul-hier-je-secret-in

# GitHub-repo (owner/repo) waar de releases + updates.json staan, voor de
# Firefox auto-update-links. Bijv. GH_REPO=owner/repo
GH_REPO=OWNER/REPO

# Doel-omgeving. build.sh substitueert deze in content.js en de manifests, zodat
# de URL's niet in de repo terechtkomen. Beide zijn verplicht.
# Meerdere clubs: door spaties gescheiden lijsten (met quotes), paarsgewijs op
# volgorde — de n-de shop hoort bij de n-de API.
API_ORIGIN=https://api.voorbeeld.test
SHOP_ORIGIN=https://shop.voorbeeld.test

# TIXX (Eventim TIXX-shops, bijv. 1. FC Köln en BvB). Eén API en één shopdomein;
# TIXX_SHOP_PATHS is het padpatroon van de shops (de club volgt uit het pad).
TIXX_API_ORIGIN=https://api.voorbeeld.test
TIXX_SHOP_ORIGIN=https://shop.voorbeeld.test
TIXX_SHOP_PATHS=/ols/*/channel/shop
# Optioneel: publieke verkoopdata-pagina's per club, "club=url club=url".
TIXX_SCHEDULES=
